<%- include('../partials/head') %>
  <body>
    <%- include('../partials/nav') %>
    <h1>Register yout home here</h1>
    <form action="/host/add-home" method="POST">
      <input
        type="text"
        name="houseName"
        placeholder="enter the name of your house"
      />
      <br><br>
       <input
        type="text"
        name="price"
        placeholder="price per night"
      />
